# Nhập các biến này trong Vercel → Project → Settings → Environment Variables.
# KHÔNG dán giá trị thật vào chat hay commit lên GitHub.

# Toàn bộ nội dung file khóa tài khoản dịch vụ Firebase (JSON) — hoặc bản base64 của file đó.
FIREBASE_SERVICE_ACCOUNT=

# (Sau này, cho trang /admin) mật khẩu dashboard
ADMIN_PASSWORD=
