        tassel_spine = [
            pt_end,
            pt_end + tan_end * 0.016,
            pt_end + tan_end * 0.034
        ]
        add_volumetric_spline_lock(
            bm, tassel_spine,
            width_profile=(0.018, 0.024, 0.008),
            thick_profile=(0.014, 0.018, 0.006),
            samples=6, n_pts=6, mat_index=0
